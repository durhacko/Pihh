# gemini module (#117, GF-WP-12; D3 granted on #218, FREE QUOTA ONLY). Names only, never values. The module receives
# only GEMINI_* variables. GOOGLE_API_KEY is never read.
#
# LIVE WHEN BOTH ARE SET: with GEMINI_ENABLED and GEMINI_API_KEY the module calls Google's generateContent for real
# (each POST /api/generate-formation is one or more upstream calls). With either one missing it is off and answers
# 503 PROVIDER_UNAVAILABLE / MODULE_DISABLED without touching the network.
# Never put the key in a committed file, a URL, a log or a VITE_* variable. scripts/gemini-live.sh reads it from a
# private file outside the repo (~/.config/encore/gemini.env, mode 600, your own file).
GEMINI_ENABLED=
GEMINI_API_KEY=
# Optional (defaults: gemini-3.1-flash-lite, 30000, 45000).
GEMINI_MODEL=
GEMINI_PROVIDER_TIMEOUT_MS=
GEMINI_REQUEST_TIMEOUT_MS=
# Backstop for the free quota: live upstream calls per gateway process, every attempt (retries included) counts.
# After that, 429 RATE_LIMITED / CALL_CAP_REACHED until a restart. Unset: 50. Range 0 to 10000 (0 = no live calls).
# An invalid value fails closed: 0, never the default.
GEMINI_MAX_CALLS=
# What each request carries for the scene shape (default on). validateScene re-checks every scene in every mode, and
# nothing is ever repaired.
#   on       the committed scene schema as responseJsonSchema (live: refused upstream with 400 INVALID_ARGUMENT)
#   slim     that schema without bounds and prose, derived at load time
#   bounded  slim, but keeping numeric minimum/maximum (live: timed out)
#   ranges   slim, plus one PLACEHOLDER system-instruction line listing the numeric ranges (live: valid scenes;
#            the line is for William's review)
#   off      JSON mode, no schema
#   text     JSON mode, no schema; the slim schema as text in the PLACEHOLDER system instruction
GEMINI_RESPONSE_SCHEMA=
