# gemini module (#117, GF-WP-12). Names only, never values. The module receives only GEMINI_* variables.
# It stays off unless BOTH GEMINI_ENABLED and GEMINI_API_KEY are set, and this build has no live provider, so it answers
# 503 PROVIDER_UNAVAILABLE / MODULE_DISABLED either way. GOOGLE_API_KEY is never read.
GEMINI_ENABLED=
GEMINI_API_KEY=
# Optional (defaults: gemini-3.1-flash-lite, 30000, 45000).
GEMINI_MODEL=
GEMINI_PROVIDER_TIMEOUT_MS=
GEMINI_REQUEST_TIMEOUT_MS=
