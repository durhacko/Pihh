# Encore gateway: gateway-level settings (server side only). Names only, never values: a test checks it.
# Export these in the gateway's own shell. Nothing loads a .env file automatically in this build, and none is
# committed. Never put a gateway value in a VITE_* variable: Vite inlines those into the app bundle.
#
# Each module documents its own variables in src/<module>/.env.example and receives only its own prefix
# (gemini: GEMINI_*, shows: MONGODB_*, tiger: TIGER_*).

# Port on 127.0.0.1. The bind address is always 127.0.0.1; GATEWAY_BIND set to anything else stops the start.
GATEWAY_PORT=
GATEWAY_BIND=

# Exact origins allowed on non-GET requests, comma-separated, e.g. the dev app's origin. Empty refuses every non-GET.
GATEWAY_ALLOWED_ORIGINS=

# 1 or true: make a per-launch token at start, print it once, and require "Authorization: Bearer <token>" on every
# route except GET /api/health.
GATEWAY_REQUIRE_TOKEN=

# Body cap in bytes, counted while streaming (default 65536, range 1024 to 1048576).
GATEWAY_MAX_BODY_BYTES=
