  "dependencies": { "three": "0.181.1" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.181.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.2.2",
    "vitest": "4.0.9"
