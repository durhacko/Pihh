{
  "$id": "encore/scene2d/v1",
  "title": "SceneSpec2D",
  "description": "A 2D silhouette in normalised space (x right, y up, z = 0, facing +z). Model-facing schema: syntax only; validateScene re-checks every constraint.",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "mode": { "type": "string", "enum": ["silhouette2d"] },
    "title": { "type": "string", "description": "1 to 60 printable characters; display only." },
    "view": { "type": "string", "enum": ["front", "side", "three-quarter"] },
    "foreground": { "$ref": "#/$defs/rgb" },
    "parts": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/part" } }
  },
  "required": ["version", "mode", "title", "view", "foreground", "parts"],
  "additionalProperties": false,
  "$defs": {
    "coord": { "type": "number", "minimum": -1.5, "maximum": 1.5 },
    "size": { "type": "number", "minimum": 0.005, "maximum": 1 },
    "vec2": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/coord" } },
    "rgb": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "part": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Lower-case letter, then up to 31 of a-z, 0-9, _ or -; unique in the scene." },
        "operation": { "type": "string", "enum": ["union", "subtract"] },
        "geometry": { "anyOf": [
          { "$ref": "#/$defs/ellipse" }, { "$ref": "#/$defs/polygon" },
          { "$ref": "#/$defs/path" }, { "$ref": "#/$defs/stroke" }
        ] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["id", "operation", "geometry", "priority"],
      "additionalProperties": false
    },
    "ellipse": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ellipse"] },
        "center": { "$ref": "#/$defs/vec2" },
        "radii": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/size" } },
        "rotationDeg": { "type": "number", "minimum": -360, "maximum": 360 }
      },
      "required": ["type", "center", "radii"],
      "additionalProperties": false
    },
    "polygon": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["polygon"] },
        "points": { "type": "array", "minItems": 3, "maxItems": 64, "items": { "$ref": "#/$defs/vec2" } }
      },
      "required": ["type", "points"],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "description": "Closed cubic Bezier chain: 3k+1 points, k = 1..32.",
      "properties": {
        "type": { "type": "string", "enum": ["path"] },
        "points": { "type": "array", "minItems": 4, "maxItems": 97, "items": { "$ref": "#/$defs/vec2" } }
      },
      "required": ["type", "points"],
      "additionalProperties": false
    },
    "stroke": {
      "type": "object",
      "description": "Open cubic Bezier chain: 3k+1 points, k = 1..8; width is the full width.",
      "properties": {
        "type": { "type": "string", "enum": ["stroke"] },
        "points": { "type": "array", "minItems": 4, "maxItems": 25, "items": { "$ref": "#/$defs/vec2" } },
        "width": { "$ref": "#/$defs/size" }
      },
      "required": ["type", "points", "width"],
      "additionalProperties": false
    }
  }
}
