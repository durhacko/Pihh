{
  "id": "FX-BAD/keys",
  "description": "R2, R16: unknown keys at any depth, $-prefixed and dotted keys, prototype keys; client-sent server fields (MDB-T07). JSON.parse keeps \"__proto__\" as an own key.",
  "cases": [
    {
      "name": "client-sent or foreign top-level _id",
      "target": "request",
      "input": {
        "schemaVersion": 1,
        "title": "T",
        "composition": {
          "v": 1,
          "movements": [
            {
              "recipe": {
                "kind": "sphere"
              },
              "holdTicks": 600
            }
          ]
        },
        "source": "manual",
        "_id": "0123456789abcdef01234567"
      },
      "expect": {
        "ok": false,
        "errors": [
          {
            "path": "_id",
            "reason": "UNKNOWN_KEY"
          }
        ]
      }
    },
