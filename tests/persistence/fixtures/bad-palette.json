    {
      "name": "null palette",
      "target": "composition",
      "input": {
        "v": 1,
        "movements": [
          {
            "recipe": {
              "kind": "sphere",
              "palette": null
            },
            "holdTicks": 600
          }
        ]
      },
      "expect": {
        "ok": false,
        "errors": [
          {
            "path": "movements[0].recipe.palette",
            "reason": "INVALID_COLOUR"
          }
        ]
      }
    },
