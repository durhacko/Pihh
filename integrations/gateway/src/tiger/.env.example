# Encore gateway, tiger module (Tiger Data analytics): the HTTP server's settings. Names only, never values (a test
# checks it). The module receives only TIGER_* variables. Never put one in a VITE_* variable.
#
# The reader credential (role encore_reader, SELECT only). No TLS parameters in the URL: sslmode, sslrootcert,
# sslcert, sslkey and ssl are refused. This build has no database driver yet, so setting it does not enable the
# module. The HTTP server REFUSES TO START if TIGER_DATABASE_URL, TIGER_ADMIN_DATABASE_URL or TIGER_LIVE_WRITE_URL
# is set in its environment: those belong to the importer, the admin tools and the live writer.
TIGER_READ_DATABASE_URL=

# Unset: TLS verify-full (default). 1: TLS require (encrypted, server not authenticated; RFC §13 risks apply).
TIGER_TLS_UNVERIFIED=

# OFFLINE ONLY, NEVER LIVE. 1 serves /api/runs and /api/runs/:runId/metrics from an in-memory fixture supplied by
# the caller (the TIG-04 fake repository fed from the committed results/). Every response says
# provenance.source "fixture" and verified false; health says source "fixture". Unset in any real deployment.
TIGER_OFFLINE_FIXTURE=
