# shows module (MongoDB Atlas show library, #130; MDB-WP-03). Server side only: copy into the gateway's ignored `.env`
# or export in the gateway's own shell. Never commit a value, and never put one in a VITE_* variable (Vite inlines those).
# This build has no MongoDB driver, so the module stays disabled (503 DATABASE_UNAVAILABLE / MODULE_DISABLED) whatever
# these hold. The live build (under D3) uses a runtime user with find, insert and listIndexes on encore.saved_shows only.
MONGODB_URI=
# Database name; default encore.
MONGODB_DB=
